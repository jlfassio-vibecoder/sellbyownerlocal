---
import Layout from '../../../../layouts/Layout.astro';
import { getOptionalSellerSession, type UserSession } from '../../../../lib/auth';
import {
  getStorefrontSegmentForSeller,
  getUserProfile,
  resolveSellerByStorefrontParam,
} from '../../../../lib/buyer-profile';
import {
  getActiveApparelForSeller,
  getClothingListingById,
} from '../../../../lib/clothing-api';
import ClothingInventoryGrid from '../../../../islands/buyer/ClothingInventoryGrid';
import ContactSellerFab from '../../../../islands/buyer/ContactSellerFab';
import ApparelAnalytics from '../../../../islands/ApparelAnalytics';
import ServiceUnavailable from '../../../../components/ServiceUnavailable.astro';
import {
  buildStorefrontSeoDescription,
  buildStorefrontSeoTitle,
  resolveAbsoluteUrl,
  resolveStorefrontOgImage,
} from '../../../../lib/seo';
import {
  getClothingListingPath,
  getStorefrontPath,
  resolveStorefrontSegment,
} from '../../../../utils/url-helpers';
import type { ClothingListing, User } from '../../../../schemas';

const { storefrontSlug: param } = Astro.params;

if (!param) {
  return Astro.rewrite('/404');
}

type SellerProfile = User & { id: string };

let serviceUnavailable = false;
let seller: SellerProfile | null = null;
let listings: ClothingListing[] = [];
let session: UserSession | null = null;
let buyerProfile: SellerProfile | null = null;
let canonicalSegment = '';
let storefrontSegmentsBySellerId: Record<string, string> = {};
let isStorefrontOwner = false;
let showRequestQuoteFab = false;
let linkToDetails = true;
let storefrontPath = '';
let canonicalUrl = '';
let storefrontTitle = 'Apparel storefront';
let storefrontSubtitle = 'Apparel storefront';
let heroUrl = '';
let pageTitle = 'Storefront · Sell By Owner Local';
let pageDescription = 'Browse local apparel from independent sellers.';
let ogImage: string | undefined;

try {
  seller = await resolveSellerByStorefrontParam(param);
  if (!seller) {
    // Legacy flat URL fallback: /marketplace/clothing/{listingId} → nested path.
    const listing = await getClothingListingById(param);
    if (listing) {
      const resolvedSegment = await getStorefrontSegmentForSeller(listing.sellerId);
      return Astro.redirect(getClothingListingPath(listing.id, resolvedSegment), 301);
    }
    return Astro.rewrite('/404');
  }

  canonicalSegment = resolveStorefrontSegment(seller);
  // Previous slug / UID fallback → 301 to current canonical storefront URL.
  if (param !== canonicalSegment) {
    return Astro.redirect(getStorefrontPath(canonicalSegment), 301);
  }

  listings = await getActiveApparelForSeller(seller.id);
  storefrontSegmentsBySellerId = { [seller.id]: canonicalSegment };

  session = await getOptionalSellerSession(Astro.request, Astro.cookies);
  buyerProfile = session ? await getUserProfile(session.uid) : null;
  isStorefrontOwner = Boolean(session?.uid && session.uid === seller.id);
  const hideRequestQuoteFab = seller.hideFab === true;
  showRequestQuoteFab = !isStorefrontOwner && !hideRequestQuoteFab;
  linkToDetails = isStorefrontOwner || seller.hideItemDetails !== true;

  const origin = Astro.site?.href ?? Astro.url.origin;
  storefrontPath = getStorefrontPath(canonicalSegment);
  canonicalUrl = resolveAbsoluteUrl(storefrontPath, origin);
  storefrontTitle = seller.storefrontName?.trim() || seller.displayName;
  const storefrontTagline = seller.storefrontTagline?.trim() || '';
  heroUrl = seller.storefrontHeroUrl?.trim() || '';
  storefrontSubtitle = storefrontTagline || 'Apparel storefront';
  pageTitle = buildStorefrontSeoTitle(storefrontTitle);
  pageDescription = buildStorefrontSeoDescription(storefrontTitle, storefrontTagline);
  ogImage = heroUrl || resolveStorefrontOgImage(listings);
} catch (error) {
  console.error('Apparel storefront lookup failed', error);
  serviceUnavailable = true;
  Astro.response.status = 503;
}

const buyerContext = {
  isLoggedIn: !!session,
  verificationTier: session?.verificationTier ?? 'anonymous',
  buyerName: buyerProfile?.displayName,
  buyerEmail: session?.email,
  buyerPhone: buyerProfile?.phone,
};
---

{
  serviceUnavailable || !seller ? (
    <Layout title="Temporarily unavailable · Sell By Owner Local">
      <ServiceUnavailable
        backHref="/marketplace/clothing"
        backLabel="Back to clothing marketplace"
      />
    </Layout>
  ) : (
    <Layout
      title={pageTitle}
      description={pageDescription}
      ogImage={ogImage}
      ogUrl={canonicalUrl}
      ogType="website"
      bodyClass="min-h-screen bg-[#f8f9fa] font-sans text-slate-900"
    >
      <ApparelAnalytics client:load surface="apparel_storefront" sellerId={seller.id} />
      {
        isStorefrontOwner && (
          <div class="sticky top-0 z-50 border-b border-slate-800 bg-slate-900 text-white shadow-md">
            <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-2.5 sm:px-6 lg:px-8">
              <p class="text-sm text-slate-300">Previewing your storefront</p>
              <a
                href="/seller/apparel"
                class="inline-flex shrink-0 items-center rounded-md border border-white/30 px-3 py-1.5 text-sm font-semibold text-white transition-colors hover:bg-white/10"
              >
                Return to Dashboard
              </a>
            </div>
          </div>
        )
      }

      {
        heroUrl ? (
          <header class="relative w-full min-h-48 overflow-hidden sm:min-h-80">
            <img
              src={heroUrl}
              alt=""
              class="absolute inset-0 h-full w-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-black/30" />
            <div class="relative mx-auto flex min-h-48 max-w-7xl flex-col justify-end px-4 py-12 sm:min-h-80 sm:px-6 sm:py-16 lg:px-8">
              <h1 class="font-brand text-4xl leading-none text-white uppercase sm:text-5xl">
                {storefrontTitle}
              </h1>
              <p class="mt-2 text-base text-white/80 sm:text-lg">{storefrontSubtitle}</p>
            </div>
          </header>
        ) : (
          <header class="border-b border-slate-200 bg-white">
            <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
              <h1 class="font-brand text-4xl leading-none text-slate-900 uppercase sm:text-5xl">
                {storefrontTitle}
              </h1>
              <p class="mt-2 text-base text-slate-500 sm:text-lg">{storefrontSubtitle}</p>
            </div>
          </header>
        )
      }

      {
        listings.length > 0 ? (
          <ClothingInventoryGrid
            client:load
            initialListings={listings}
            storefrontSegmentsBySellerId={storefrontSegmentsBySellerId}
            buyerContext={buyerContext}
            catalogPdfHref={`/api/storefront/${encodeURIComponent(canonicalSegment)}/catalog.pdf`}
            showFab={showRequestQuoteFab}
            linkToDetails={linkToDetails}
          />
        ) : (
          <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
            <div class="rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center">
              <p class="text-lg font-medium text-slate-700">
                {storefrontTitle} doesn't have any active items right now.
              </p>
              <p class="mt-2 text-sm text-slate-500">Check back later.</p>
            </div>
          </main>
        )
      }

      {
        listings.length === 0 && showRequestQuoteFab && (
          <ContactSellerFab
            client:load
            isLoggedIn={buyerContext.isLoggedIn}
            verificationTier={buyerContext.verificationTier}
            buyerName={buyerContext.buyerName}
            buyerEmail={buyerContext.buyerEmail}
            buyerPhone={buyerContext.buyerPhone}
          />
        )
      }
    </Layout>
  )
}
