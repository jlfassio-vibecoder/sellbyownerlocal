---
interface Props {
  heading?: string;
  message?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  heading = 'Temporarily unavailable',
  message = "We're having trouble loading marketplace data right now. Please try again shortly.",
  backHref = '/',
  backLabel = 'Back to home',
} = Astro.props;
---

<main class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center">
    <p class="text-lg font-medium text-slate-700">{heading}</p>
    <p class="mt-2 text-sm text-slate-500">{message}</p>
    <a href={backHref} class="mt-6 inline-block text-sm font-medium text-slate-700 underline">
      {backLabel}
    </a>
  </div>
</main>
